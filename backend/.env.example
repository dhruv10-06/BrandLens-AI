# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# MongoDB Atlas Database URL
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/brandlens?retryWrites=true&w=majority
# If left empty in local development, an automatic in-memory MongoDB instance will be used for testing.
MONGODB_URI=

# JWT Secrets
JWT_SECRET=super-secret-brandlens-jwt-key-change-in-production-min32chars
JWT_EXPIRES_IN=7d

# Google Gemini API Key
# Obtain free from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_MS=60000

# File Upload Configuration
MAX_FILE_SIZE_MB=10

